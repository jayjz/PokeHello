{
  "name": "pokehello",
  "version": "0.1.0",
  "description": "Pokémon TCG sniping bot",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run gui\" \"node index.js\"",
    "start:pokemon": "node index.js pokemon",
    "start:target": "node index.js target",
    "start:walmart": "node index.js walmart",
    "dev": "nodemon index.js",
    "dev:gui": "nodemon gui/server.js",
    "gui": "node gui/server.js",
    "test": "node index.js --dry-run",
    "monitor": "node monitors/pokemon-center.js",
    "monitor:pokemon": "node monitors/pokemon-center.js",
    "monitor:target": "node monitors/target.js",
    "monitor:walmart": "node monitors/walmart.js",
    "monitor:all": "concurrently \"npm run monitor:pokemon\" \"npm run monitor:target\" \"npm run monitor:walmart\""
  },
  "keywords": [
    "pokemon",
    "tcg",
    "bot",
    "sniping"
  ],
  "author": "jayjz",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.16.1",
    "concurrently": "^9.2.1",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "got-scraping": "^4.2.1",
    "node-cron": "^3.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "puppeteer-real-browser": "^1.4.4",
    "socket.io": "^4.8.3",
    "tough-cookie": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
